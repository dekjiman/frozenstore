# --- Minimal required (Portainer / server deploy) ---
# DATABASE_URL diatur otomatis oleh docker-compose.yml, override hanya jika pakai DB external
# DATABASE_URL=postgresql://frozenstore:frozenstore@db:5432/frozenstore

# Acak minimal 32 karakter (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CART_SESSION_SECRET=CHANGE_ME_RANDOM_SECRET

# Auto-login magic link (WA notifikasi order) — wajib untuk produksi
AUTO_LOGIN_SECRET=CHANGE_ME_RANDOM_SECRET

# Port host (container selalu expose 3000)
APP_PORT=8090

# Ganti <IP> dengan alamat IP publik/temporary server
NEXT_PUBLIC_BASE_URL=http://<IP>:8090

# --- WhatsApp Evolution API (opsional) ---
EVOLUTION_BASE_URL=
EVOLUTION_INSTANCE_NAME=store
EVOLUTION_API_KEY=

# --- Google OAuth (opsional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Ads (opsional) ---
NEXT_PUBLIC_AD_CLIENT_ID=
NEXT_PUBLIC_AD_SLOT_BOTTOM=
NEXT_PUBLIC_AD_SLOT_ARTICLE=
NEXT_PUBLIC_AD_SLOT_HOME=